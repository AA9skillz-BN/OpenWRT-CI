#!/bin/sh
uci set firewall.@defaults[0].flow_offloading='1'
uci set firewall.@defaults[0].flow_offloading_hw='1'
uci commit firewall
uci set turboacc.config.sw_flow='1'
uci set turboacc.config.hw_flow='1'
uci set turboacc.config.sfe_flow='0'
uci set turboacc.config.hw_wed='1'
uci set turboacc.config.bbr_cca='1'
uci set turboacc.config.fullcone_nat='1'
uci commit turboacc
# BBR 拥塞控制（内核编了 CONFIG_TCP_CONG_BBR 才生效，5G 高延迟链路更稳）
if grep -qw bbr /proc/sys/net/ipv4/tcp_available_congestion_control 2>/dev/null; then
	# 立即生效
	echo bbr > /proc/sys/net/ipv4/tcp_congestion_control 2>/dev/null
	# 持久化两条路：
	#  1) sysctl.d —— 首次开机时 /etc/init.d/sysctl 已经跑过，这个文件是现在才创建的，
	#     所以第一次开机加载不到，要等第二次重启
	#  2) /etc/sysctl.conf —— OpenWrt 官方推荐的用户配置位置，sysctl init 同样会读
	#     这里直接追加，保证新装设备第一次开机就是 bbr（实测踩过这个时序坑）
	echo 'net.ipv4.tcp_congestion_control=bbr' >/etc/sysctl.d/11-tr3000-bbr.conf
	grep -q '^net.ipv4.tcp_congestion_control=bbr' /etc/sysctl.conf 2>/dev/null ||
		echo 'net.ipv4.tcp_congestion_control=bbr' >>/etc/sysctl.conf
fi
exit 0
