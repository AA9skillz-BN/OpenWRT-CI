#!/bin/sh
# SPDX-License-Identifier: MIT
# Select the existing OEM/second system; never copy firmware partitions.
. /lib/functions/c8-system.sh || exit 1
case "${1:-}" in
 status) c8_read_boot_system ;;
 official|0|second|1)
  command -v flock >/dev/null 2>&1 || exit 1
  c8_lock || exit 1
  case "$1" in official|0) c8_select_system 0 ;; *) c8_select_system 1 ;; esac
  ;;
 *) echo "用法: $0 [status|official|second]" >&2; exit 2 ;;
esac
