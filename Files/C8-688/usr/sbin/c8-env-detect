#!/bin/sh
# SPDX-License-Identifier: MIT
# Discover a CRC-valid C8 environment without changing its contents.
# The real board uses a single 0x80000-byte environment at p2 offset zero.
. /lib/functions/c8-system.sh || exit 1
CONF=/etc/fw_env.config
DEV=/dev/mmcblk0p2
CANDIDATES="0x80000 0x8000 0x4000 0x10000 0x20000 0x2000"

command -v fw_printenv >/dev/null 2>&1 || exit 1
command -v flock >/dev/null 2>&1 || exit 1
c8_lock || exit 1
c8_check_platform || exit 1
candidate=$(mktemp "${CONF}.XXXXXX") || exit 1
trap 'rm -f "$candidate"' EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
for sz in $CANDIDATES; do
 printf '%s 0x0 %s\n' "$DEV" "$sz" > "$candidate" || exit 1
 if v=$(fw_printenv -c "$candidate" -n boot_system 2>/dev/null); then
  case "$v" in 0|1) ;; *) continue ;; esac
  chmod 0644 "$candidate" && mv -f "$candidate" "$CONF" || exit 1
  logger -t c8-env "CRC-valid env size=$sz boot_system=$v"
  exit 0
 fi
done
# Keep the existing file on failure; never install a guessed fallback config.
echo 'c8-env-detect: 未找到 CRC 有效且 boot_system=0/1 的环境；保留原配置' >&2
exit 1
