
config main 'main'
	# OTA 总开关（关闭后仍可手动执行 c8-688-ota，只是页面/定时不再提示）
	option enabled '1'

	# 固件发布仓库（GitHub owner/repo）
	option repo 'AA9skillz-BN/OpenWRT-CI'

	# 只认这个 tag 前缀的 Release（与 Config/C8-688.txt 的 WRT_CONFIG 对应）
	option tag_prefix 'C8-688-immortalwrt-master-'

	# 默认保留配置；c8-688-ota upgrade --wipe 可临时覆盖
	option keep_config '1'

	# 下载大文件时先走镜像前缀（元数据永远只信 api.github.com，且有 sha256 校验）
	option use_mirror '1'

	# 镜像/固件的落盘目录（eMMC，勿放 /tmp）
	option dir '/root/ota'

	# 每天 04:15 自动检查；设 0 后现存定时调用也会立即跳过
	option auto_check '1'

	# 镜像前缀，按顺序尝试，失败自动回落 GitHub 直连
	list mirror 'https://gh-proxy.com/'
	list mirror 'https://ghfast.top/'
