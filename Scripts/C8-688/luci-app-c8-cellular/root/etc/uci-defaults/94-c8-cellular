#!/bin/sh
# SPDX-License-Identifier: MIT
# Create missing sections/options only. Never touch network/firewall/APN or
# enable a user-disabled connection, and never read another firmware's secrets.
set -e
umask 077
[ -z "${IPKG_INSTROOT:-}" ] || exit 0
if ! uci -q get mt5700m.settings >/dev/null; then
	uci -q set mt5700m.settings=mt5700m
	uci -q set mt5700m.settings.enabled=1
	uci -q set mt5700m.settings.mode=auto
	uci -q set mt5700m.settings.timeout=8
fi
if ! uci -q get mt5700m.connection >/dev/null; then
	uci -q set mt5700m.connection=connection
	uci -q set mt5700m.connection.enabled=1
	uci -q set mt5700m.connection.pdp_type=ipv4v6
	uci -q set mt5700m.connection.metric=50
fi
uci -q commit mt5700m
if ! uci -q get c8_cellular.notify >/dev/null; then
    uci -q set c8_cellular.notify=notify
    uci -q set c8_cellular.notify.enabled=0
    uci -q commit c8_cellular
fi
/etc/init.d/c8-cellular enable
# Preserve an operator's previously disabled manager service. Fresh images
# already carry its package enable link; no service restart during migration.
exit 0
