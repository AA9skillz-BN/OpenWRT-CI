#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: MIT
START=81
STOP=29
USE_PROCD=1
start_service() {
	[ "$(cat /tmp/sysinfo/board_name 2>/dev/null)" = 'nradio,c8-688' ] || return 1
	procd_open_instance broker
	procd_set_param command /usr/bin/python3 /usr/libexec/c8-cellular/broker.py
	procd_set_param respawn 3600 5 5
	procd_set_param stderr 1
	procd_close_instance
	procd_open_instance notify
	procd_set_param command /usr/bin/python3 /usr/libexec/c8-cellular/notify.py
	procd_set_param respawn 3600 5 5
	procd_close_instance
}
