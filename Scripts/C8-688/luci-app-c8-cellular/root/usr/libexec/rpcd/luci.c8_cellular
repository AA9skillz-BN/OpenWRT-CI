#!/usr/bin/python3
# SPDX-License-Identifier: MIT
import json
import socket
import sys

if len(sys.argv) == 2 and sys.argv[1] == "list":
    print(json.dumps({"submit": {"operation": "", "value": "", "request": ""},
                      "result": {"id": ""}}))
elif len(sys.argv) == 3 and sys.argv[1] == "call" and sys.argv[2] in ("submit", "result"):
    try:
        request = json.loads(sys.stdin.read(8193))
        # Do not forward arbitrary fields or permit selecting the local method.
        names = ("operation", "value", "request") if sys.argv[2] == "submit" else ("id",)
        request = {name: request.get(name, "") for name in names}
        request["method"] = sys.argv[2]
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as client:
            client.settimeout(4)
            client.connect("/var/run/c8-cellular/rpc.sock")
            client.sendall(json.dumps(request).encode() + b"\n")
            stream = client.makefile("rb")
            response = stream.readline(1048577)
            if not response.endswith(b"\n") or len(response) > 1048576:
                raise ValueError()
            print(json.dumps(json.loads(response)))
    except Exception:
        print(json.dumps({"error": "cellular_service_unavailable"}))
else:
    sys.exit(1)
