#!/bin/sh
# SPDX-License-Identifier: MIT
set -eu
umask 077
case "$(cat /tmp/sysinfo/board_name 2>/dev/null)" in nradio,c8-688) ;; *) exit 64;; esac
. /usr/share/mt5700m/lock.sh
export C8_SLOT_RECOVERY=1
mt5700m_action_lock || exit $?
AT_HELPER=/usr/sbin/mt5700m-at
log_message() { logger -t c8-cellular -- "$*"; }
. /usr/share/mt5700m/profile.sh
. /usr/share/c8-cellular/slots.sh
slot_recover || exit 1
recover_profile_transaction || exit 1

case "$1" in
at)
    command="$2"
    case "$command" in
        'AT+CONNECT?')
            mode="$(uci -q get mt5700m.settings.mode || echo auto)"
            if [ "$mode" = network ]; then value=0; else value=1; fi
            printf '+CONNECT: %s\r\nOK\r\n' "$value"
            ;;
        AT^SETAUTODIAL=*)
            desired="${command#AT^SETAUTODIAL=}"
            # The WEBUI also sends short enable/mode changes. Fill them from
            # the modem's actual profile, never from empty factory defaults.
            case "$desired" in
                0) ;;
                1,1|1,2)
                    old="$(c8_profile_query)" || exit 1
                    profile_valid "$old" && [ "$old" != 0 ] || exit 64
                    rest="${old#*,}"; rest="${rest#*,}"
                    desired="$desired,$rest"
                    ;;
            esac
            apply_profile_transaction "$desired" || exit 1
            printf 'OK\r\n'
            ;;
        AT^SCICHG=*) exit 64;;
        AT+WEBHOOK*)
            /usr/bin/python3 /usr/libexec/c8-cellular/notify.py command "$command"
            ;;
        AT+CMGL=4)
            "$AT_HELPER" command 'AT+CMGF=0' >/dev/null || exit 1
            "$AT_HELPER" command "$command"
            ;;
        *)
            # Original helper owns the transport's synchronization fence and
            # quarantine. All manager, SMS and UI operations use the same lock.
            "$AT_HELPER" command "$command"
            ;;
    esac
    ;;
slot)
    slot_switch "$2" || exit 1
    printf '{"slot":"%s","state":"selected","registration_verified":false}\n' "$2"
    ;;
diagnostics)
    /usr/bin/python3 /usr/libexec/c8-cellular/diagnostics.py
    ;;
*) exit 64;;
esac
