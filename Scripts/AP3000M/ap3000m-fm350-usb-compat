#!/bin/sh /etc/rc.common
# Opt-in workaround for the USB data stall observed on this AP3000M.
# USB 2.0 limits throughput. This does not diagnose a hardware/firmware cause.
START=90
STOP=09

start() {
	[ "$(uci -q get fm350.main.usb2_compat)" = 1 ] || return 0
	[ "$(cat /tmp/sysinfo/board_name 2>/dev/null)" = airpi,ap3000m ] || return 1
	local port vendor product
	port=/sys/bus/usb/devices/usb2/2-0:1.0/usb2-port1
	case "$(readlink -f "$port" 2>/dev/null)" in
		/sys/devices/platform/soc/11200000.usb/usb2/2-0:1.0/usb2-port1) ;;
		*) logger -t fm350-usb-compat 'Unexpected USB topology; leaving USB unchanged'; return 1 ;;
	esac
	[ -w "$port/disable" ] || return 1
	[ "$(cat "$port/disable")" != 1 ] || return 0
	if [ -f /sys/bus/usb/devices/2-1/idVendor ]; then
		vendor=$(cat /sys/bus/usb/devices/2-1/idVendor)
		product=$(cat /sys/bus/usb/devices/2-1/idProduct)
		case "$vendor:$product" in
			0e8d:7126|0e8d:7127) ;;
			*) logger -t fm350-usb-compat 'Different USB device present; leaving USB unchanged'; return 1 ;;
		esac
	fi
	if /etc/init.d/fm350d status >/dev/null 2>&1; then
		logger -t fm350-usb-compat 'Dial daemon already running; apply at next boot'
		return 1
	fi
	printf '1\n' > "$port/disable" || return 1
	[ "$(cat "$port/disable")" = 1 ] || return 1
	logger -t fm350-usb-compat 'Applied user-enabled FM350 USB 2.0 compatibility before dial daemon'
}
