#!/bin/sh
# SPDX-License-Identifier: MIT
# 98-ap3000m-gpt-fix —— 无损修正 eMMC 扩容后未对齐磁盘末尾的 GPT 备份分区表
#
# 真机现象：刷入固件镜像后主分区已使用 7.2G eMMC，但 GPT 备份头仍停留在旧扇区位置，
# 内核启动提示 "GPT: Use GNU Parted to correct GPT errors"，sgdisk -v 报 3 处错误。
# 这里仅在确认板型为 airpi,ap3000m 且 sgdisk -v 检出备份头错位时执行一次 sgdisk -e。

[ -f /tmp/sysinfo/board_name ] || exit 0
[ "$(cat /tmp/sysinfo/board_name 2>/dev/null)" = "airpi,ap3000m" ] || exit 0
[ -b /dev/mmcblk0 ] || exit 0
command -v sgdisk >/dev/null 2>&1 || exit 0

check_out=$(sgdisk -v /dev/mmcblk0 2>&1 || true)
case "$check_out" in
	*"doesn't reside at the end of the disk"*|*"overlaps the backup header"*|*"claims the disk is larger"*)
		if sgdisk -e /dev/mmcblk0 >/dev/null 2>&1; then
			logger -t ap3000m-gpt "已将 /dev/mmcblk0 GPT 备份分区表移至磁盘末尾"
		else
			logger -t ap3000m-gpt "sgdisk -e 执行失败，保留原状等待人工检查"
			exit 1
		fi
		;;
esac

exit 0
