#!/bin/sh
# SPDX-License-Identifier: MIT
# ap3000m-net-tune —— FM350-GL (USB 3.0 RNDIS) 稳定性锁死与全链路低延迟高吞吐调优
#
# FM350 只有 RNDIS 一种数据通路（GTUSBMODE 40/41 都是 RNDIS），没有 ECM/NCM 可选。
# 围绕「满速 USB 3.0 不掉线 + 双核吞吐榨干 + 无线空口低延迟」做七件事：
#   1. USB 3.0 U0 锁定：在核对 AP3000M 端口拓扑与 FM350 VID:PID 后关闭 usb3_lpm_permit
#      (禁用易诱发 MTK T750 RNDIS Bulk-IN 卡死的 U1/U2 低功耗跳变)，锁定 power/control=on 与 autosuspend=-1
#   2. 硬中断双核物理隔离：CPU1 专职 xhci-hcd (USB 3.0)，CPU0 专职 mt7915e (Wi-Fi 6) 与以太网硬中断
#   3. 全接口 RPS/XPS + RFS：eth2 (rfs=4096) 与 LAN/Wi-Fi (rfs=2048) 双核分摊，解决 packet_steering 单核拥塞
#   4. MT7981 Wi-Fi 6 AQL 空口降延迟：收紧 phy* aql_threshold=12000 与各 AC aql_txq_limit，压低满载抖动
#   5. GRO 微秒聚合：gro_flush_timeout=20000 + napi_defer_hard_irqs=2 合并突发帧减负协议栈
#   6. txqueuelen：加大至 2000 配合 fq_codel 适配 5G 高带宽时延积
#   7. 双栈 MTU 探测：用 DF ping 实测 IPv4/IPv6 不分片上限并持久化
#
# 用法：
#   ap3000m-net-tune apply [dev]   应用即时参数（USB3 U0/IRQ/RPS/RFS/AQL/GRO/队列/已缓存 MTU）
#   ap3000m-net-tune probe [dev]   实测双栈 MTU 并缓存到 /etc/ap3000m-mtu
#   ap3000m-net-tune status [dev]  打印当前生效值

set -u

MTU_CACHE=/etc/ap3000m-mtu
PING_HOST4=223.5.5.5
PING_HOST6=2400:3200::1
USB3_PORT=/sys/bus/usb/devices/usb2/2-0:1.0/usb2-port1
USB3_DEV=/sys/bus/usb/devices/2-1
USB3_BUS=/sys/bus/usb/devices/usb2
USB2_BUS=/sys/bus/usb/devices/usb1
USBCORE_AUTOSUSPEND=/sys/module/usbcore/parameters/autosuspend
IEEE80211_DEBUG=/sys/kernel/debug/ieee80211

log() { logger -t ap3000m-net "$*" 2>/dev/null; printf '%s\n' "ap3000m-net-tune: $*" >&2; }

dev_of() {
	d="${1:-}"
	[ -n "$d" ] && { printf '%s' "$d"; return; }
	d=$(uci -q get network.fm350.device 2>/dev/null)
	[ -n "$d" ] && printf '%s' "$d" || printf 'eth2'
}

cpu_count() {
	# 直接数 /sys/devices/system/cpu 下的 cpuN 目录：比 nproc 可靠
	n=$(ls -d /sys/devices/system/cpu/cpu[0-9]* 2>/dev/null | wc -l)
	[ "${n:-0}" -ge 1 ] || n=$(nproc 2>/dev/null || echo 1)
	[ "$n" -ge 8 ] && n=8
	printf '%s' "$n"
}

rps_mask() {
	n=$(cpu_count)
	printf '%x' $(( (1 << n) - 1 ))
}

is_reviewed_fm350_usb() {
	case "$(readlink -f "$USB3_PORT" 2>/dev/null)" in
		/sys/devices/platform/soc/11200000.usb/usb2/2-0:1.0/usb2-port1) ;;
		*) return 1 ;;
	esac
	[ -f "$USB3_DEV/idVendor" ] && [ -f "$USB3_DEV/idProduct" ] || return 1
	v=$(cat "$USB3_DEV/idVendor" 2>/dev/null)
	p=$(cat "$USB3_DEV/idProduct" 2>/dev/null)
	case "$v:$p" in
		0e8d:7126|0e8d:7127) return 0 ;;
		*) return 1 ;;
	esac
}

lock_usb3_power_u0() {
	# 保留 5000M USB 3.0 全速，禁止 U1/U2 链路低功耗睡眠与控制器/全局自动挂起，消除唤醒卡死与抖动
	is_reviewed_fm350_usb || return 0
	state=""
	if [ -w "$USB3_PORT/usb3_lpm_permit" ]; then
		echo 0 >"$USB3_PORT/usb3_lpm_permit" 2>/dev/null && state="lpm=0"
	fi
	for ctrl in "$USB3_DEV/power/control" "$USB3_BUS/power/control" "$USB2_BUS/power/control"; do
		[ -w "$ctrl" ] && echo on >"$ctrl" 2>/dev/null
	done
	[ -w "$USB3_DEV/power/autosuspend" ] && echo -1 >"$USB3_DEV/power/autosuspend" 2>/dev/null
	[ -w "$USBCORE_AUTOSUSPEND" ] && echo -1 >"$USBCORE_AUTOSUSPEND" 2>/dev/null
	[ -r "$USB3_DEV/power/control" ] && state="${state:+$state,}pwr=$(cat "$USB3_DEV/power/control" 2>/dev/null)"
	printf '%s' "$state"
}

pin_xhci_irq() {
	# MT7981B 双核硬中断物理隔离：CPU1 专职 FM350 所在的 xhci-hcd，
	# CPU0 专职 mt7915e 无线与 15100000.ethernet 有线网口硬中断。
	[ "$(cpu_count)" -ge 2 ] || return 0
	pinned=""
	for irq in $(awk '/xhci-hcd/ {sub(/:/, "", $1); print $1}' /proc/interrupts 2>/dev/null); do
		[ -w "/proc/irq/$irq/smp_affinity" ] || continue
		if echo 2 >"/proc/irq/$irq/smp_affinity" 2>/dev/null; then
			pinned="${pinned:+$pinned,}$irq->2"
		fi
	done
	for irq in $(awk '/mt7915e|15100000\.ethernet/ {sub(/:/, "", $1); print $1}' /proc/interrupts 2>/dev/null); do
		[ -w "/proc/irq/$irq/smp_affinity" ] || continue
		if echo 1 >"/proc/irq/$irq/smp_affinity" 2>/dev/null; then
			pinned="${pinned:+$pinned,}$irq->1"
		fi
	done
	printf '%s' "$pinned"
}

xhci_irq_status() {
	out=""
	for irq in $(awk '/xhci-hcd|mt7915e/ {sub(/:/, "", $1); print $1}' /proc/interrupts 2>/dev/null); do
		[ -r "/proc/irq/$irq/smp_affinity" ] || continue
		val=$(cat "/proc/irq/$irq/smp_affinity" 2>/dev/null)
		out="${out:+$out,}$irq:$val"
	done
	printf '%s' "${out:-na}"
}

tune_wifi_aql() {
	# 收紧 mt76 Wi-Fi 6 空口排队上限（默认 5000/12000us -> 1500~2500/3000~5000us），保留 HE160 聚合并压低满载抖动
	aql_done=0
	for phy in "$IEEE80211_DEBUG"/phy*; do
		[ -d "$phy" ] || continue
		if [ -w "$phy/aql_threshold" ]; then
			echo 12000 >"$phy/aql_threshold" 2>/dev/null
		fi
		if [ -w "$phy/aql_txq_limit" ]; then
			echo "0 1500 3000" >"$phy/aql_txq_limit" 2>/dev/null
			echo "1 2000 4000" >"$phy/aql_txq_limit" 2>/dev/null
			echo "2 2500 5000" >"$phy/aql_txq_limit" 2>/dev/null
			echo "3 2000 4000" >"$phy/aql_txq_limit" 2>/dev/null
			aql_done=$((aql_done + 1))
		fi
	done
	printf '%s' "$aql_done"
}

tune_rps_xps_all() {
	dev="$1"
	mask="$2"
	nq=0
	for f in /sys/class/net/"$dev"/queues/rx-*/rps_cpus; do
		[ -w "$f" ] || continue
		echo "$mask" >"$f" 2>/dev/null
		nq=$((nq + 1))
	done
	for f in /sys/class/net/"$dev"/queues/rx-*/rps_flow_cnt; do
		[ -w "$f" ] || continue
		echo 4096 >"$f" 2>/dev/null
	done
	for f in /sys/class/net/"$dev"/queues/tx-*/xps_cpus; do
		[ -w "$f" ] || continue
		echo "$mask" >"$f" 2>/dev/null
	done
	for lan_dev in eth0 eth1 phy0-ap0 phy1-ap0; do
		[ -d "/sys/class/net/$lan_dev" ] || continue
		for f in /sys/class/net/"$lan_dev"/queues/rx-*/rps_cpus; do
			[ -w "$f" ] && echo "$mask" >"$f" 2>/dev/null
		done
		for f in /sys/class/net/"$lan_dev"/queues/rx-*/rps_flow_cnt; do
			[ -w "$f" ] && echo 2048 >"$f" 2>/dev/null
		done
		for f in /sys/class/net/"$lan_dev"/queues/tx-*/xps_cpus; do
			[ -w "$f" ] && echo "$mask" >"$f" 2>/dev/null
		done
	done
	printf '%s' "$nq"
}

apply_tuning() {
	dev=$(dev_of "${1:-}")
	aql_cnt=$(tune_wifi_aql)
	[ -d "/sys/class/net/$dev" ] || { log "设备 $dev 不存在（已应用 Wi-Fi AQL=$aql_cnt），跳过网卡项"; return 1; }

	usb_u0=$(lock_usb3_power_u0)
	irq_pin=$(pin_xhci_irq)
	mask=$(rps_mask)
	nq=$(tune_rps_xps_all "$dev" "$mask")

	# RNDIS 单帧送交协议栈开销高；开启 20us GRO 聚合窗口合并 5G 突发流
	[ -w "/sys/class/net/$dev/gro_flush_timeout" ] && echo 20000 >"/sys/class/net/$dev/gro_flush_timeout" 2>/dev/null
	[ -w "/sys/class/net/$dev/napi_defer_hard_irqs" ] && echo 2 >"/sys/class/net/$dev/napi_defer_hard_irqs" 2>/dev/null

	ip link set dev "$dev" txqueuelen 2000 2>/dev/null

	mtu=$(cat "$MTU_CACHE" 2>/dev/null)
	if [ -n "$mtu" ]; then
		ip link set dev "$dev" mtu "$mtu" 2>/dev/null
	fi

	real=""
	for f in /sys/class/net/"$dev"/queues/rx-*/rps_cpus; do
		[ -r "$f" ] && real="$real $(cat "$f" 2>/dev/null)"
	done
	log "已应用：dev=$dev cpus=$(cpu_count) mask=$mask usb3=[${usb_u0:-跳过}] irq=${irq_pin:-不变} rx队列=$nq 回读=[$real] aql_phy=$aql_cnt gro=$(cat /sys/class/net/"$dev"/gro_flush_timeout 2>/dev/null) txqueuelen=$(cat /sys/class/net/"$dev"/tx_queue_len 2>/dev/null) mtu=${mtu:-默认}"
}

probe_mtu() {
	dev=$(dev_of "${1:-}")
	ip4=$(ip -4 -o addr show dev "$dev" 2>/dev/null | awk '{print $4}' | cut -d/ -f1 | head -n 1)
	[ -n "$ip4" ] || { log "设备 $dev 还没有 IPv4，稍后再探 MTU"; return 1; }

	if ! ping -M do -c 1 -W 1 127.0.0.1 >/dev/null 2>&1; then
		log "当前 ping 不支持 -M do（busybox），跳过 MTU 实测，保持 $(cat /sys/class/net/"$dev"/mtu 2>/dev/null)"
		return 2
	fi

	has_v6=0
	if ip -6 -o addr show dev "$dev" scope global 2>/dev/null | grep -q 'inet6 '; then
		ping -6 -c 1 -W 1 -I "$dev" "$PING_HOST6" >/dev/null 2>&1 && has_v6=1
	fi

	for mtu in 1500 1476 1460 1452 1432 1420 1400 1360 1300 1280; do
		payload4=$((mtu - 28))
		if ping -M do -s "$payload4" -c 1 -W 2 -I "$ip4" "$PING_HOST4" >/dev/null 2>&1; then
			if [ "$has_v6" = 1 ]; then
				payload6=$((mtu - 48))
				ping -6 -M do -s "$payload6" -c 1 -W 2 -I "$dev" "$PING_HOST6" >/dev/null 2>&1 || continue
			fi
			printf '%s\n' "$mtu" >"$MTU_CACHE"
			ip link set dev "$dev" mtu "$mtu" 2>/dev/null
			uci -q set network.fm350.mtu="$mtu" 2>/dev/null
			uci -q commit network 2>/dev/null
			log "MTU 实测结果：$mtu（v4_payload=$payload4 v6_checked=$has_v6，经 $ip4）"
			return 0
		fi
	done

	log "MTU 探测失败（链路可能未就绪），保持默认"
	return 1
}

show_status() {
	dev=$(dev_of "${1:-}")
	printf 'dev=%s\n' "$dev"
	printf 'mtu=%s\n' "$(cat /sys/class/net/"$dev"/mtu 2>/dev/null)"
	printf 'tx_queue_len=%s\n' "$(cat /sys/class/net/"$dev"/tx_queue_len 2>/dev/null)"
	printf 'gro_flush_timeout=%s napi_defer_hard_irqs=%s\n' \
		"$(cat /sys/class/net/"$dev"/gro_flush_timeout 2>/dev/null)" \
		"$(cat /sys/class/net/"$dev"/napi_defer_hard_irqs 2>/dev/null)"
	for f in /sys/class/net/"$dev"/queues/rx-*/rps_cpus /sys/class/net/"$dev"/queues/rx-*/rps_flow_cnt; do
		[ -e "$f" ] && printf '%s=%s\n' "${f#/sys/class/net/}" "$(cat "$f" 2>/dev/null)"
	done
	printf 'xhci_irq_affinity=%s\n' "$(xhci_irq_status)"
	if is_reviewed_fm350_usb; then
		printf 'usb3_speed=%s usb3_lpm_permit=%s usb_power=%s/%s\n' \
			"$(cat "$USB3_DEV/speed" 2>/dev/null)" \
			"$(cat "$USB3_PORT/usb3_lpm_permit" 2>/dev/null)" \
			"$(cat "$USB3_DEV/power/control" 2>/dev/null)" \
			"$(cat "$USB3_BUS/power/control" 2>/dev/null)"
	fi
	printf 'cached_mtu=%s\n' "$(cat "$MTU_CACHE" 2>/dev/null)"
	printf 'cc=%s qdisc=%s liberal=%s slow_start_idle=%s\n' \
		"$(sysctl -n net.ipv4.tcp_congestion_control 2>/dev/null)" \
		"$(sysctl -n net.core.default_qdisc 2>/dev/null)" \
		"$(sysctl -n net.netfilter.nf_conntrack_tcp_be_liberal 2>/dev/null)" \
		"$(sysctl -n net.ipv4.tcp_slow_start_after_idle 2>/dev/null)"
}

case "${1:-apply}" in
	apply)  shift; apply_tuning "${1:-}" ;;
	probe)  shift; probe_mtu "${1:-}" ;;
	status) shift; show_status "${1:-}" ;;
	*) printf '用法: %s [apply|probe|status] [dev]\n' "$0" >&2; exit 2 ;;
esac
