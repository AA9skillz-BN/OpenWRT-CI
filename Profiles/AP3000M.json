  "required_packages": [
    "luci-app-ttyd",
    "ttyd",
    "luci-theme-aurora",
    "luci-app-aurora-config",
    "kmod-usb-net-rndis",
    "kmod-usb-net-cdc-ncm",
    "kmod-usb-net-cdc-ether",
    "kmod-nft-offload",
    "kmod-tcp-bbr",
    "luci-app-fm350",
    "luci-app-airpi-fancontrol",
    "luci-app-ap3000m-ota",
    "jq",
    "kmod-airpi-gpio-fan",
    "kmod-hwmon-pwmfan",
    "kmod-usb-serial-option",
    "audio-support",
    "kmod-sound-core",
    "kmod-usb-audio"
  ],
  "packages": [
    "mini-diskmanager",
    "viking",
    "partexp",
    "natmapt",
    "stuntman",
    "luci-natmapt",
    "aurora",
    "aurora-config",
    "fm350",
    "fancontrol"
  ],
  "release_note": "eMMC 机型 sysupgrade 固件；内置 FM350 首启配置、风扇管理、OTA 和 RNDIS 自愈。",
  "device_symbol": "CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_airpi_ap3000m",
  "config_fragments": [
    "Config/BASE.txt",
    "Config/Features/services.txt",
    "Config/Features/usb.txt",
    "Config/Features/storage.txt",
    "Config/Features/diagnostics.txt"
  ],
  "excluded_feed_packages": {
    "luci-app-fwknopd": [
      "luci-app-fwknopd"
    ],
    "squeezelite": [
      "squeezelite-full",
      "squeezelite-dynamic",
      "squeezelite-custom"
    ]
  },
  "build_tag_file": "/etc/ap3000m-build.tag",
  "required_files": [
    {
      "path": "/usr/sbin/ap3000m-ota",
      "source": "Scripts/AP3000M/ota/ap3000m-ota",
      "executable": true
    },
    {
      "path": "/usr/sbin/ap3000m-rdnis-guard",
      "source": "Scripts/AP3000M/rdnis-guard/ap3000m-rdnis-guard",
      "executable": true
    },
    {
      "path": "/usr/sbin/ap3000m-net-tune",
      "source": "Scripts/AP3000M/net-tune/ap3000m-net-tune",
      "executable": true
    },
    {
      "path": "/etc/uci-defaults/99-ap3000m-fm350",
      "source": "Scripts/AP3000M/fm350-ap3000m",
      "executable": true
    },
    {
      "path": "/etc/init.d/ap3000m-ota-boot",
      "executable": true,
      "source": "Scripts/AP3000M/ota/ap3000m-ota-boot"
    },
    {
      "path": "/etc/init.d/ap3000m-rdnis-guard",
      "executable": true,
      "source": "Scripts/AP3000M/rdnis-guard/ap3000m-rdnis-guard-boot"
    },
    {
      "path": "/etc/rc.d/S99ap3000m-ota-boot",
      "executable": true
    },
    {
      "path": "/etc/rc.d/S98ap3000m-rdnis-guard",
      "executable": true
    }
  ]
}
